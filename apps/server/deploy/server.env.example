# Install manually as /opt/voxcode/shared/config/server.env (root:voxcode 0640).
# Values contain paths/origins, never secret values. Avoid shell metacharacters.
VOXCODE_HOST=0.0.0.0
VOXCODE_PORT=9899
VOXCODE_PUBLIC_ORIGIN=https://100.100.81.209:9899
VOXCODE_DATA=/opt/voxcode/shared/state
VOXCODE_TASK_SOCKET=/run/voxcode-task/rpc.sock
# Replace with id -u voxcode-task after manual account provisioning.
VOXCODE_TASK_UID=REPLACE_WITH_TASK_UID
VOXCODE_LOGIN_SECRET_FILE=/opt/voxcode/shared/config/login-secret
VOXCODE_MCP_ENDPOINT_FILE=/opt/voxcode/shared/config/mcp-endpoint
VOXCODE_TLS_CERT=/opt/voxcode/shared/config/server-cert.pem
VOXCODE_TLS_KEY=/opt/voxcode/shared/config/server-key.pem
