# Configure the same machine ID/key on relay server and Mac connector only.
# Generate a random key with: openssl rand -hex 32
VOXCODE_MACHINE_ID=company-mac
VOXCODE_MACHINE_KEY=

# Relay server: keep loopback until deployment is explicitly resumed.
VOXCODE_RELAY_HOST=127.0.0.1
VOXCODE_RELAY_PORT=9899
# File paths; both required together for HTTPS. No private keys in this file.
VOXCODE_TLS_CERT=
VOXCODE_TLS_KEY=

# Company Mac, outbound connection only:
VOXCODE_RELAY_URL=wss://121.52.250.201:9899/connector
VOXCODE_BRIDGE_URL=http://127.0.0.1:8787
# Public CA PEM file path; required for this private-CA endpoint.
VOXCODE_TLS_CA=
