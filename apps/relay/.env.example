# Configure the same machine ID/key on relay server and Mac connector only.
# Generate a random key with: openssl rand -hex 32
VOXCODE_MACHINE_ID=company-mac
VOXCODE_MACHINE_KEY=

# Relay server, behind a trusted HTTPS reverse proxy:
VOXCODE_RELAY_HOST=127.0.0.1
VOXCODE_RELAY_PORT=8788

# Company Mac, outbound connection only:
VOXCODE_RELAY_URL=wss://your-domain.example/connector
VOXCODE_BRIDGE_URL=http://127.0.0.1:8787
