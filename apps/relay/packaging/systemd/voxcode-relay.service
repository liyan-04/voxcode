[Unit]
Description=VoxCode Relay (user-managed)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.local/lib/voxcode-relay/config/relay.env
WorkingDirectory=%h/.local/lib/voxcode-relay/app
ExecStart=/usr/bin/env node --env-file=%h/.local/lib/voxcode-relay/config/relay.env %h/.local/lib/voxcode-relay/app/relay-cli.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
