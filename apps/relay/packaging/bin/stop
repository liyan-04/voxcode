#!/usr/bin/env bash
set -euo pipefail
prefix="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
stopped=0
owned_pid() {
  local pid="$1" role="$2" command
  command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  [[ "$command" == *"$prefix/app/${role}-cli.mjs"* ]]
}
for role in relay connector; do
  pid_file="$prefix/run/${role}.pid"
  [[ -r "$pid_file" ]] || continue
  pid="$(cat "$pid_file")"
  if kill -0 "$pid" 2>/dev/null && owned_pid "$pid" "$role"; then
    kill "$pid"
    echo "Stopped $role pid $pid"
    stopped=1
  elif kill -0 "$pid" 2>/dev/null; then
    echo "Refusing to stop pid $pid: command is not this VoxCode $role"
    continue
  else
    echo "Removed stale $role pid $pid"
  fi
  rm -f "$pid_file"
done
(( stopped == 1 )) || echo 'No running VoxCode process found'
