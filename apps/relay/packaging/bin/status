#!/usr/bin/env bash
set -euo pipefail
prefix="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
found=0
owned_pid() {
  local pid="$1" role="$2" command
  command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  [[ "$command" == *"$prefix/app/${role}-cli.mjs"* ]]
}
for role in relay connector; do
  pid_file="$prefix/run/${role}.pid"
  if [[ -r "$pid_file" ]]; then
    pid="$(cat "$pid_file")"
    if kill -0 "$pid" 2>/dev/null && owned_pid "$pid" "$role"; then
      echo "$role: running (pid $pid)"
      found=1
    elif kill -0 "$pid" 2>/dev/null; then
      echo "$role: pid $pid belongs to another command; refusing to manage it"
    else
      echo "$role: stale pid file (pid $pid)"
    fi
  else
    echo "$role: stopped"
  fi
done
(( found == 1 ))
