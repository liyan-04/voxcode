#!/usr/bin/env expect
# Password contents are read here, never passed in argv or an environment value.
log_user 0
if {[llength $argv] < 5} { puts stderr "Invalid vm6 password transport request"; exit 2 }
set secret_path [lindex $argv 0]
set program [lindex $argv 1]
set args [lrange $argv 2 end]
if {$program ni {ssh scp}} { puts stderr "Only SSH/SCP are supported"; exit 2 }
set fixed_target "root@100.100.81.209"
set valid_target 0
set strict_host 0
foreach arg $args {
    if {$arg eq $fixed_target || [string first "$fixed_target:/opt/voxcode/" $arg] == 0} { set valid_target 1 }
    if {$arg eq "StrictHostKeyChecking=yes"} { set strict_host 1 }
    if {[regexp {StrictHostKeyChecking=(no|accept-new)|UserKnownHostsFile=/dev/null|ProxyCommand|ProxyJump} $arg]} { puts stderr "Unsafe SSH option"; exit 2 }
}
if {!$valid_target || !$strict_host} { puts stderr "Password transport is restricted to the fixed vm6 target with strict host keys"; exit 2 }
if {[catch {
    file lstat $secret_path secret_stat
    if {$secret_stat(type) ne "file" || ($secret_stat(mode) & 077) != 0 || $secret_stat(uid) != [exec id -u]} { error "permissions" }
    set file [open $secret_path r]
    set password [string trimright [read $file 4097] "\r\n"]
    close $file
}]} { puts stderr "Cannot read private password file"; exit 1 }
if {$password eq "" || [string length $password] > 4096 || [regexp {[\r\n]} $password]} { puts stderr "Invalid password file"; exit 1 }
set timeout 20
spawn -noecho $program {*}$args
set password_sent 0
expect {
    -re {(?i)password:[ \t]*} {
        if {$password_sent} { puts stderr "Repeated authentication prompt"; exit 1 }
        send -- "$password\r"
        set password_sent 1
        set timeout -1
        exp_continue
    }
    timeout { puts stderr "SSH authentication timed out"; exit 124 }
    eof {
        # log_user=0 does not prevent an echoing PTY from buffering credentials.
        set safe_output [string map [list $password "<redacted>"] $expect_out(buffer)]
        unset password
        puts -nonewline $safe_output
        set result [wait]
        if {[lindex $result 2] != 0 || [llength $result] > 4} { exit 1 }
        exit [lindex $result 3]
    }
}
